background-blur = true
background-opacity = 0.95
cursor-style = bar

font-family = "Berkeley Mono"
font-family-italic = "Cartograph CF"
font-family-bold-italic = "Cartograph CF"
font-feature = +calt
font-size = "16"
font-style = "Regular"

mouse-hide-while-typing = true

shell-integration = zsh
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

theme = dark:tokyonight_night,light:tokyonight_day

unfocused-split-opacity = 1

window-inherit-font-size = true
window-padding-balance = true
window-padding-x = 8
window-vsync = false

working-directory = inherit

keybind = global:cmd+shift+grave_accent=toggle_quick_terminal

keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+l=goto_split:right
keybind = ctrl+w>ctrl+w=goto_split:next
